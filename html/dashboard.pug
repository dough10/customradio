          | Scrape

      button.menu-button(title='logout')
        svg(viewBox="0 -960 960 960" aria-label='logout', fill="currentColor" )
          path(d="M234-276q51-39 114-61.5T480-360q69 0 132 22.5T726-276q35-41 54.5-93T800-480q0-133-93.5-226.5T480-800q-133 0-226.5 93.5T160-480q0 59 19.5 111t54.5 93Zm246-164q-59 0-99.5-40.5T340-580q0-59 40.5-99.5T480-720q59 0 99.5 40.5T620-580q0 59-40.5 99.5T480-440Zm0 360q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q53 0 100-15.5t86-44.5q-39-29-86-44.5T480-280q-53 0-100 15.5T294-220q39 29 86 44.5T480-160Zm0-360q26 0 43-17t17-43q0-26-17-43t-43-17q-26 0-43 17t-17 43q0 26 17 43t43 17Zm0-60Zm0 360Z")
        | Logout

    header
      button#login.small-button(title="login")
        svg(viewBox="0 -960 960 960" aria-label='login', fill="currentColor" )
          path(d="M234-276q51-39 114-61.5T480-360q69 0 132 22.5T726-276q35-41 54.5-93T800-480q0-133-93.5-226.5T480-800q-133 0-226.5 93.5T160-480q0 59 19.5 111t54.5 93Zm246-164q-59 0-99.5-40.5T340-580q0-59 40.5-99.5T480-720q59 0 99.5 40.5T620-580q0 59-40.5 99.5T480-440Zm0 360q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q53 0 100-15.5t86-44.5q-39-29-86-44.5T480-280q-53 0-100 15.5T294-220q39 29 86 44.5T480-160Zm0-360q26 0 43-17t17-43q0-26-17-43t-43-17q-26 0-43 17t-17 43q0 26 17 43t43 17Zm0-60Zm0 360Z")

    main
      .card
        h4
          | DATABASE STATS
        div
          span
            span
              | Last update ended: 
            span#lastCompleted
              | !{new Date(lastUpdate.end.time).toLocaleString(undefined, { weekday: 'short', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })}
          span
            span
              | Last update duration: 
            span#updateDuration

        div
          span
            span
              | Next scheduled update: 
            span#nextUpdate
          span
            span 
              | Time till scheduled update: 
            span#nextTime

        div
          span
            span
              | Total stations: 
            span#total
              | !{lastUpdate.end.total}
          span
            span
              | Online stations: 
            span#online
              | !{lastUpdate.end.online}

      .card#updates
        div
          h4#updateHeader
            | UPDATING
          button.small-button#stop
            svg(viewBox="0 0 24 24" alt='stop')
              path(fill="currentColor" d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z")

        #progress.bar-wrapper
          .bar

        div
          span#counts
            | 0/0
          span#percent
            | 0%

        div
          span
            span
              | Changed:
            span#changed
              | 0
          span 
            span
              | Remaining:
            span#remaining
              | 0

        div
          span
            span
              | Run Time:
            span#runTime
              | 0 Seconds
          span 
            span
              | Approx Completion Time:
            span#ACT
              | ??:??

        div
          span
            span
              | Mem Heap:
            span#heap
              | ?? MB
          span 
            span
              | Mem RSS:
            span#RSS
              | ?? MB

      .card
        div
          h4 
            | LOG
          div
            label(for='level') Log Level:
            select#level(name='level')
              //- populated by JS

        #log

      .card
        div
          h4
            | REQUESTS

          div
            label(for="hours") Time period:
            select#hours(name="hours")
              option(value=1) 1 hour
              option(value=6) 6 hours
              option(value=12) 12 hours
              option(value=24 selected) 24 hours
              option(value=48) 2 days (48 hours)
              option(value=120) 5 days (120 hours)

        div
          span
            span
              | Requests: 
            span#reqTotal
              | #{requests.totalRequests}
          span
            span
              | Average request pre hour: 
            span#ave 
              | #{requests.averagePerHour}

        canvas#requests(width='1000px' height='200px')

    script(nonce=nonce src='dashboard.min.js' async)