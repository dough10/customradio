html(lang=lang)
  head
    meta(charset="UTF-8")
    meta(name="author" content="dough10")
    meta(name="csrf-token" content=csrf)
    meta(name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover")

    script(src="https://cdn.jsdelivr.net/npm/chart.js" nonce=nonce)

    script(nonce=nonce).
      window.user = !{JSON.stringify(user)};
      window.requests = !{JSON.stringify(requests || { averagePerHour: 0, time: [], counts: [], totalRequests: 0 })};
      window.lastUpdate = !{JSON.stringify(lastUpdate)}
    link(rel="preload" href="dashboard.min.css" as="style")
    link(rel='stylesheet' href='dashboard.min.css')

  body
    nav#user-menu
      header
        .avatar-wrapper
          | ?
        .firstname= user.firstName
        .lastname= user.lastname

      if admin
